generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EDITOR
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  DENIED
}

enum GenModel {
  NANO_BANANA_2
  GPT_IMAGE_2
  KLING_O3
  SEEDANCE_2
}

enum JobType {
  IMAGE
  VIDEO
}

enum JobStatus {
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetKind {
  INPUT
  OUTPUT
}

/// Creative tracker pipeline, mirroring the team's previous spreadsheet.
/// BACKLOG stands in for the sheet's blank Status cell.
enum CreativeStatus {
  BACKLOG
  SCRIPTING
  EDITING
  NEEDS_REVIEW
  NEEDS_REVISION
  READY
}

enum CreativePriority {
  NORMAL
  IMPORTANT
  URGENT
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String
  role            Role         @default(EDITOR)
  /// Descriptive job title (Editor, Strategist, …) — display only, never
  /// affects permissions. Free-form string so the option list can change in
  /// code (lib/job-titles.ts) without a migration.
  jobTitle        String?
  status          UserStatus   @default(PENDING)
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime     @default(now())
  jobs            Job[]
  usageEvents     UsageEvent[]
  creatives       Creative[]   @relation("CreativeEditor")

  @@index([status, createdAt])
}

/// One row of the creative tracker (previously a row in the team's Google Sheet).
model Creative {
  id            String           @id @default(cuid())
  /// "2026-07" — replaces the sheet's monthly tabs.
  month         String
  lp            String?
  page          String?
  strategist    String?
  title         String
  briefLink     String?
  /// Editor name as typed (people in the sheet may not have accounts yet);
  /// editorUserId links the row to an app user when they do.
  editor        String?
  editorUserId  String?
  editorUser    User?            @relation("CreativeEditor", fields: [editorUserId], references: [id], onDelete: SetNull)
  videoLink     String?
  contentNeeded Boolean          @default(true)
  status        CreativeStatus   @default(BACKLOG)
  priority      CreativePriority @default(NORMAL)
  aiModel       String?
  generations   Int?
  launchedAt    DateTime?
  cogScore      Int?
  isWinner      Boolean          @default(false)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([month, createdAt])
  @@index([editorUserId])
  @@index([status])
}

model Job {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model              GenModel
  type               JobType
  status             JobStatus    @default(IN_QUEUE)
  falRequestId       String?      @unique
  input              Json
  prompt             String
  optimizedPrompt    String?
  logs               Json?
  errorMessage       String?
  estimatedCostCents Int          @default(0)
  actualMetrics      Json?
  createdAt          DateTime     @default(now())
  completedAt        DateTime?
  assets             Asset[]
  usageEvents        UsageEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model Asset {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind        AssetKind
  r2Key       String?
  url         String
  contentType String
  width       Int?
  height      Int?
  durationSec Float?
  fileSize    Int?
  createdAt   DateTime  @default(now())

  @@index([jobId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  model     GenModel
  costCents Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
