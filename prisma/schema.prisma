generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EDITOR
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  DENIED
}

enum GenModel {
  NANO_BANANA_2
  GPT_IMAGE_2
  KLING_O3
  SEEDANCE_2
  /// Re-voice an existing generation: TTS with a library voice + Kling lip-sync.
  KLING_LIPSYNC
  /// Swap the voice of a video's existing speech (ElevenLabs speech-to-speech
  /// + audio remux) — keeps the words and timing, no typing.
  VOICE_SWAP
  /// Google Veo 3.1 Lite (via omnirouter / webinhour).
  VEO_3
  /// Omni Zone generations (Omni Flash 1.1, via omnirouter / webinhour).
  OMNI_FLASH
}

enum JobType {
  IMAGE
  VIDEO
}

enum JobStatus {
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetKind {
  INPUT
  OUTPUT
}

/// Creative tracker pipeline, mirroring the team's previous spreadsheet.
/// BACKLOG stands in for the sheet's blank Status cell.
enum CreativeStatus {
  BACKLOG
  SCRIPTING
  EDITING
  NEEDS_REVIEW
  NEEDS_REVISION
  READY
}

enum CreativePriority {
  NORMAL
  IMPORTANT
  URGENT
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String
  role            Role         @default(EDITOR)
  /// Job title (Editor, Strategist, …). Cosmetic except in the creative
  /// tracker, where "Strategist" grants full board access (see trackerCaps()).
  /// Free-form string so the option list can change in code without a migration.
  jobTitle        String?
  status          UserStatus   @default(PENDING)
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdAt       DateTime     @default(now())
  jobs            Job[]
  usageEvents     UsageEvent[]
  creatives       Creative[]   @relation("CreativeEditor")
  strategistOn    Creative[]   @relation("CreativeStrategist")
  resetTokens     PasswordResetToken[]
  omniProjects    OmniProject[]
  avatars         Avatar[]
  editorAliases   EditorAlias[]
  bonusAwards     BonusAward[]
  redemptions     Redemption[]
  pointsEntries   PointsEntry[]
  rewardsProfile  RewardsProfile?

  @@index([status, createdAt])
}

/// Admin-managed API keys / secrets, overriding env vars at runtime so keys
/// can be rotated from the dashboard without a redeploy. Values are stored
/// AES-256-GCM encrypted (key derived from AUTH_SECRET, which lives in env —
/// never in the DB), so a DB-only leak cannot expose them.
model AppSecret {
  name          String   @id
  valueEncrypted String
  updatedByEmail String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

/// One-time password-reset tokens. A row created via "user" is a reset
/// REQUEST (surfaced to admins until fulfilled, or emailed directly when an
/// email service is configured); rows created by an admin carry their email.
/// Only the sha256 of the URL token is stored — never the raw value.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  /// "user" for self-serve requests, else the minting admin's email.
  createdVia String
  /// True when the reset link was emailed to the user directly.
  emailed    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// One row of the creative tracker (previously a row in the team's Google Sheet).
model Creative {
  id            String           @id @default(cuid())
  /// "2026-07" — replaces the sheet's monthly tabs.
  month         String
  lp            String?
  page          String?
  /// Name as shown; strategistUserId links it to a registered user. The plain
  /// name is kept so rows imported from the sheet (people who may not have
  /// accounts yet) still display correctly.
  strategist      String?
  strategistUserId String?
  strategistUser  User?           @relation("CreativeStrategist", fields: [strategistUserId], references: [id], onDelete: SetNull)
  title         String
  briefLink     String?
  /// Editor name as typed (people in the sheet may not have accounts yet);
  /// editorUserId links the row to an app user when they do.
  editor        String?
  editorUserId  String?
  editorUser    User?            @relation("CreativeEditor", fields: [editorUserId], references: [id], onDelete: SetNull)
  videoLink     String?
  contentNeeded Boolean          @default(true)
  status        CreativeStatus   @default(BACKLOG)
  priority      CreativePriority @default(NORMAL)
  aiModel       String?
  generations   Int?
  launchedAt    DateTime?
  cogScore      Int?
  isWinner      Boolean          @default(false)
  notes         String?
  /// Soft delete: archived rows disappear from the tracker but are always
  /// recoverable by an admin. Nothing is ever hard-deleted.
  archivedAt    DateTime?
  archivedBy    String?
  createdById   String?
  createdByName String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  changes       CreativeChange[]

  @@index([month, createdAt])
  @@index([editorUserId])
  @@index([strategistUserId])
  @@index([status])
  @@index([archivedAt])
}

enum VoiceEngine {
  MINIMAX
  ELEVENLABS
}

/// A saved voice for talking-avatar videos: either cloned via MiniMax (on fal)
/// or via ElevenLabs (direct API). providerVoiceId is the engine's own id
/// (MiniMax custom_voice_id / ElevenLabs voice_id).
model Voice {
  id              String      @id @default(cuid())
  name            String
  provider        VoiceEngine
  providerVoiceId String
  /// Reference sample the voice was cloned from (fal storage URL).
  sampleUrl       String?
  /// Short generated clip for the picker. Also proves the clone works.
  previewUrl      String?
  /// MiniMax deletes clones unused by TTS for 7 days; tracked to warn + refresh.
  lastUsedAt      DateTime?
  archivedAt      DateTime?
  archivedBy      String?
  createdById     String
  createdByName   String
  createdAt       DateTime    @default(now())

  // One library entry per engine voice — guards concurrent double-imports.
  @@unique([provider, providerVoiceId])
  @@index([archivedAt, createdAt])
}

/// Append-only audit trail: who changed what on a creative, and when.
model CreativeChange {
  id         String   @id @default(cuid())
  creativeId String
  creative   Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  userId     String?
  userName   String
  /// CREATE | UPDATE | ARCHIVE | RESTORE
  action     String
  /// [{ field, from, to }] for UPDATE; empty for the others.
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([creativeId, createdAt])
}

model Job {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model              GenModel
  type               JobType
  status             JobStatus    @default(IN_QUEUE)
  falRequestId       String?      @unique
  input              Json
  prompt             String
  optimizedPrompt    String?
  logs               Json?
  errorMessage       String?
  estimatedCostCents Int          @default(0)
  actualMetrics      Json?
  createdAt          DateTime     @default(now())
  completedAt        DateTime?
  assets             Asset[]
  usageEvents        UsageEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model Asset {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind        AssetKind
  r2Key       String?
  url         String
  contentType String
  width       Int?
  height      Int?
  durationSec Float?
  fileSize    Int?
  createdAt   DateTime  @default(now())

  @@index([jobId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  model     GenModel
  costCents Int
  /// Seconds of video generated (null for images / unknown).
  seconds   Float?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Omni Zone project: one editor's private workspace (never visible to other
/// users, admins included). Its generations are ordinary Jobs tagged with
/// input.projectId, so they still show in the Library for admins.
model OmniProject {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  /// "16:9" | "9:16" — also the canvas the stitched export is rendered at.
  aspectRatio String     @default("9:16")
  /// Avatars picked for this project; Create mode starts with these selected.
  /// Ids only — deleted/unshared avatars are filtered out on read.
  avatarIds   String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  clips       OmniClip[]

  @@index([userId, updatedAt])
}

/// One clip on a project's timeline, in `position` order.
model OmniClip {
  id          String      @id @default(cuid())
  projectId   String
  project     OmniProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position    Int
  label       String
  url         String
  /// Set when the clip came from one of the owner's own generations.
  sourceJobId String?
  /// Non-destructive trim, in seconds of the source file. trimEnd null = play to the end.
  /// A "cut" splits one clip into two rows over the same source.
  trimStart   Float       @default(0)
  trimEnd     Float?
  createdAt   DateTime    @default(now())

  @@index([projectId, position])
}

/// Named character for consistency across Omni Zone generations. The owner
/// decides whether the rest of the team can see and use it (`shared`).
model Avatar {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Reference image stored in-app (not on fal's ~7-day CDN) so avatars
  /// persist and private ones stay private. Resized client-side, ≤2MB.
  imageData   Bytes
  imageType   String
  shared      Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([shared, createdAt])
  @@index([createdById])
}

// ─── Rewards (admin-only while testing) ─────────────────────────────────────

/// One row of the creative-tracking Google Sheet, as last seen by the sync.
/// An ad counts as approved when its status turns "Ready" AFTER tracking
/// began: rows already Ready at the first sync are `preexisting` and never count.
model SheetCreative {
  /// "<tab gid>:<normalised title>#<n>" — the sheet has no row ids.
  key         String    @id
  tab         String
  title       String
  /// Editor cell as typed (may name several people: "Ali, Cassandra").
  editorName  String?
  status      String
  preexisting Boolean   @default(false)
  /// When the sync first saw it Ready (cleared if it leaves Ready).
  approvedAt  DateTime?
  /// Admin voided this approval (it no longer counts).
  voidedAt    DateTime?
  firstSeenAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([approvedAt])
}

/// Sheet editor name → Studio account (e.g. "nicu" → Lance). userId null =
/// explicitly unmapped (overrides the automatic name match).
model EditorAlias {
  /// Normalised (lower-case) sheet name.
  sheetName String  @id
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Singleton sync status.
model RewardsSync {
  id         String    @id @default("main")
  /// Set by the first successful sync: everything Ready then is "old".
  baselineAt DateTime?
  lastSyncAt DateTime?
  lastError  String?
  rows       Int       @default(0)
}

enum BonusKind {
  WEEKLY
  MONTHLY
}

/// A weekly / monthly target hit. Unique per editor + period, so it's awarded
/// once; revoking keeps the row so the next sync doesn't re-award it.
model BonusAward {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      BonusKind
  /// "2026-W44" (weekly) or "2026-10" (monthly).
  period    String
  approvals Int
  cashCents Int
  points    Int
  paidAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, kind, period])
}

/// Something editors can buy with points.
model RewardItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  /// "cash" | "item" | "perk"
  kind        String       @default("item")
  costPoints  Int
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  redemptions Redemption[]
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  REJECTED
}

model Redemption {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       RewardItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemName   String
  costPoints Int
  status     RedemptionStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())
}

/// Points ledger — balance is the sum of deltas (never stored).
model PointsEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Prestige state. Level/points are derived from approvals; prestiging bumps
/// `prestige` and moves `xpOffset` by one full run (level 1 → 50).
model RewardsProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prestige  Int      @default(0)
  xpOffset  Int      @default(0)
  updatedAt DateTime @updatedAt
}
