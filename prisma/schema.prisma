generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EDITOR
  ADMIN
}

enum GenModel {
  NANO_BANANA_2
  GPT_IMAGE_2
  KLING_O3
  SEEDANCE_2
}

enum JobType {
  IMAGE
  VIDEO
}

enum JobStatus {
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetKind {
  INPUT
  OUTPUT
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         Role         @default(EDITOR)
  createdAt    DateTime     @default(now())
  jobs         Job[]
  usageEvents  UsageEvent[]
}

model Job {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model              GenModel
  type               JobType
  status             JobStatus    @default(IN_QUEUE)
  falRequestId       String?      @unique
  input              Json
  prompt             String
  optimizedPrompt    String?
  logs               Json?
  errorMessage       String?
  estimatedCostCents Int          @default(0)
  actualMetrics      Json?
  createdAt          DateTime     @default(now())
  completedAt        DateTime?
  assets             Asset[]
  usageEvents        UsageEvent[]

  @@index([userId, createdAt])
  @@index([status])
}

model Asset {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind        AssetKind
  r2Key       String?
  url         String
  contentType String
  width       Int?
  height      Int?
  durationSec Float?
  fileSize    Int?
  createdAt   DateTime  @default(now())

  @@index([jobId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  model     GenModel
  costCents Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
